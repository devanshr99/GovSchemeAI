# GovSchemeAI Frontend - Environment Variables Example
# Duplicate this file to .env and configure as needed.

# Server-side proxy destination URL (Next.js rewrites)
BACKEND_URL=http://localhost:8000

# Client-side direct production API URL (Vercel deployment)
# Example: NEXT_PUBLIC_API_URL=https://govscheme-ai-api.onrender.com
NEXT_PUBLIC_API_URL=
